# Server-only upstream. Never add NEXT_PUBLIC_ to a provider key or this URL.
CHAT_API_URL=http://127.0.0.1:8000
# The backend LLM request has a 60-second deadline.
CHAT_API_TIMEOUT_MS=70000

# Optional, server-only CrewAI service. Leave unset until it is available.
# CREWAI_API_URL=http://127.0.0.1:8001
# Flows may take longer than chat. A timeout does not cancel a running flow.
CREWAI_API_TIMEOUT_MS=120000
